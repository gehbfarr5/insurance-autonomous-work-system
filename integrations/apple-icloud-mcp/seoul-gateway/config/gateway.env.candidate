# gateway.env.candidate
# AG-03 Candidate Environment Configuration for Seoul MCP (apple-icloud-mcp)
#
# Placed on Seoul Host at /opt/insurance-carddav-mcp/config/macserver-gateway.env (0600)
#
# Candidate preparation only. Deployment requires separate approval.

# Gateway endpoint (mapped via local Tailscale tunnel or direct Tailscale IP)
MACSERVER_EVENTKIT_ENDPOINT=http://127.0.0.1:18765

# Restricted Bearer Token matching ~/.config/muse-macserver/bridge.env on MacServer
# (Generated during B1 installation; 32-byte hexadecimal / secure secret)
MACSERVER_EVENTKIT_TOKEN=REDACTED_LOCAL_TOKEN_FROM_MACSERVER_BRIDGE_ENV

# Request Timeout in Milliseconds (500 - 60000)
MACSERVER_EVENTKIT_TIMEOUT_MS=5000

# Permitted iCloud List UUIDs (exact match allowlist)
# Bound test list from AG-02 B2/B3: 9D9A****03F3
MACSERVER_EVENTKIT_ALLOWED_LIST_IDS=9D9A5AAD-E3F0-4459-8756-BBCDBCB703F3

# Source Identity Verification (FIX-R4A-02)
MACSERVER_EVENTKIT_EXPECTED_SOURCE_TYPE=calDAV
MACSERVER_EVENTKIT_EXPECTED_SOURCE_NAME=iCloud
