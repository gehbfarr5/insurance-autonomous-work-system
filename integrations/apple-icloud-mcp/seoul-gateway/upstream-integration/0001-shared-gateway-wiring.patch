@@ -0,0 +1,68 @@
+import { AppError } from '../../../core/errors.js';
+import type { Session } from '../../../core/session.js';
+import type { ReminderService, ListRemindersParams, ReminderInput, UpdateOptions } from './types.js';
+import { createReminderService } from '../service.js';
+import { loadGatewayConfigFromEnv } from './config.js';
+import { EventKitReadonlyTransport } from './transport.js';
+import { createMacServerReminderService } from './service.js';
+
+export * from './types.js';
+export * from './config.js';
+export * from './transport.js';
+export * from './service.js';
+
+let sharedTransport: EventKitReadonlyTransport | undefined;
+let sharedConfig: ReturnType<typeof loadGatewayConfigFromEnv> | undefined;
+
+export function isMacServerGatewayConfigured(): boolean {
+  return Boolean(
+    process.env.MACSERVER_EVENTKIT_ENDPOINT ||
+    process.env.EVENTKIT_GATEWAY_ENDPOINT ||
+    process.env.EVENTKIT_BRIDGE_ENDPOINT
+  );
+}
+
+export function getGatewayReminderService(session: Session): ReminderService {
+  if (!isMacServerGatewayConfigured()) {
+    return createReminderService({ account: session.account, caldav: session.providers.caldav });
+  }
+
+  if (!sharedConfig) {
+    sharedConfig = loadGatewayConfigFromEnv(process.env);
+    sharedTransport = new EventKitReadonlyTransport(sharedConfig);
+  }
+
+  const baseGateway = createMacServerReminderService({
+    transport: sharedTransport!,
+    config: sharedConfig!,
+    account: session.account,
+  });
+
+  return {
+    async listLists() {
+      if (!session.account.capabilities.remindersRead) {
+        throw new AppError('PERMISSION_DENIED', '该账号的提醒事项读取权限未开启', {
+          hint: 'ALLOW_REMINDERS_READ',
+        });
+      }
+      return baseGateway.listLists();
+    },
+    async list(params: ListRemindersParams) {
+      if (!session.account.capabilities.remindersRead) {
+        throw new AppError('PERMISSION_DENIED', '该账号的提醒事项读取权限未开启', {
+          hint: 'ALLOW_REMINDERS_READ',
+        });
+      }
+      return baseGateway.list(params);
+    },
+    async create(input: ReminderInput, listId?: string) {
+      return baseGateway.create(input, listId);
+    },
+    async update(reminderId: string, patch: Partial<ReminderInput>, options?: UpdateOptions) {
+      return baseGateway.update(reminderId, patch, options);
+    },
+    async remove(reminderId: string, options?: UpdateOptions) {
+      return baseGateway.remove(reminderId, options);
+    },
+  };
+}
diff --git a/src/modules/reminders/gateway/service.ts b/src/modules/reminders/gateway/service.ts
new file mode 100644
index 0000000..9b0e923
--- /dev/null
+++ b/src/modules/reminders/gateway/service.ts
@@ -0,0 +1,309 @@
+/**
+ * service.ts
+ * MacServerReminderService implementation for Seoul -> MacServer Reminders Readonly Gateway.
+ * 
+ * Adapts MacServer EventKit Bridge HTTP endpoints to standard ReminderService interface:
+ * - listLists: maps to ReminderListSummary[] with writable: false
+ * - list: maps to ListRemindersResult with Reminder[]
+ * - create/update/remove: rejects client-side with PERMISSION_DENIED (zero write forwarding)
+ * 
+ * Invariants:
+ * 1. Strictly READ-ONLY: Rejects write operations with 0 forwarding and 0 VTODO fallback.
+ * 2. Strict Item Field Validation: itemID, listID, title, isCompleted are mandatory;
+ *    missing, empty, or mismatched listID is immediately rejected with UPSTREAM_ERROR.
+ * 3. Error objects are NEVER mapped into normal reminders.
+ * 4. Bound list verification: Only allowed and bound lists are returned or queried.
+ */
+
+import { AppError } from '../../../core/errors.js';
+import { parseBridgeDate, EventKitReadonlyTransport } from './transport.js';
+import type {
+  BoundListConfig,
+  ListRemindersParams,
+  ListRemindersResult,
+  MacServerGatewayConfig,
+  PartialFailure,
+  Reminder,
+  ReminderInput,
+  ReminderItem,
+  ReminderListSummary,
+  ReminderService,
+  RemindersList,
+  UpdateOptions,
+  AccountConfig,
+} from './types.js';
+
+function parseLimit(rawLimit?: number): number {
+  if (rawLimit === undefined) return 500;
+  if (!Number.isInteger(rawLimit) || rawLimit <= 0) {
+    throw new AppError('INVALID_INPUT', `limit 必须为正整数: ${rawLimit}`);
+  }
+  return Math.min(rawLimit, 1000);
+}
+
+function parseDueBound(label: string, value?: string): Date | undefined {
+  if (!value) return undefined;
+  const d = new Date(value);
+  if (Number.isNaN(d.getTime())) {
+    throw new AppError('INVALID_INPUT', `${label} 格式无法解析为有效日期: ${value}`);
+  }
+  return d;
+}
+
+export interface MacServerReminderServiceDeps {
+  transport: EventKitReadonlyTransport;
+  config: MacServerGatewayConfig;
+  account?: AccountConfig;
+}
+
+export function createMacServerReminderService(deps: MacServerReminderServiceDeps): ReminderService {
+  const { transport, config, account } = deps;
+
+  const requireRead = (): void => {
+    if (account && account.capabilities && account.capabilities.remindersRead === false) {
+      throw new AppError('PERMISSION_DENIED', '该账号的提醒事项读取权限未开启', {
+        hint: 'ALLOW_REMINDERS_READ',
+      });
+    }
+  };
+
+  const bindingIndex = new Map<string, BoundListConfig>();
+  for (const b of config.allowedLists) {
+    bindingIndex.set(b.listId, b);
+  }
+
+  async function fetchAllowedICloudLists(): Promise<RemindersList[]> {
+    const rawLists = await transport.fetchListsMetadata();
+
+    const verifiedLists: RemindersList[] = [];
+    for (const list of rawLists) {
+      if (!list || typeof list !== 'object' || Array.isArray(list)) {
+        throw new AppError('UPSTREAM_ERROR', 'Bridge 返回的列表元数据不是有效对象');
+      }
+      if (typeof list.listID !== 'string' || !list.listID.trim()) {
+        throw new AppError('UPSTREAM_ERROR', 'Bridge 列表元数据缺失或包含非法的 listID');
+      }
+      if (typeof list.title !== 'string') {
+        throw new AppError('UPSTREAM_ERROR', 'Bridge 列表元数据缺失或包含非法的 title');
+      }
+      if (typeof list.sourceID !== 'string' || !list.sourceID.trim()) {
+        throw new AppError('UPSTREAM_ERROR', 'Bridge 列表元数据缺失或包含非法的 sourceID');
+      }
+      if (typeof list.sourceType !== 'string' || typeof list.sourceName !== 'string') {
+        throw new AppError('UPSTREAM_ERROR', 'Bridge 列表元数据缺失有效的 source 字段');
+      }
+
+      const binding = bindingIndex.get(list.listID);
+      if (!binding) continue;
+
+      if (list.sourceID !== binding.expectedSourceId) {
+        continue;
+      }
+
+      const expType = binding.expectedSourceType || config.expectedSourceType || 'calDAV';
+      const expName = binding.expectedSourceName || config.expectedSourceName || 'iCloud';
+
+      if (list.sourceType.toLowerCase() !== expType.toLowerCase()) {
+        continue;
+      }
+      if (list.sourceName.toLowerCase() !== expName.toLowerCase()) {
+        continue;
+      }
+
+      verifiedLists.push(list);
+    }
+
+    return verifiedLists;
+  }
+
+  function rejectWriteOp(op: string): never {
+    throw new AppError(
+      'PERMISSION_DENIED',
+      `[WriteRejected] MacServer EventKit 网关运行于严格只读模式: 提醒事项 ${op} 写操作已在客户端拦截 (零转发/零VTODO回落/禁止写入并禁止回落旧 VTODO)`
+    );
+  }
+
+  return {
+    async listLists(): Promise<ReminderListSummary[]> {
+      requireRead();
+      const lists = await fetchAllowedICloudLists();
+      return lists.map((list) => ({
+        list_id: list.listID,
+        name: list.title,
+        color: list.color,
+        writable: false,
+      }));
+    },
+
+    async list(params: ListRemindersParams): Promise<ListRemindersResult> {
+      requireRead();
+      const limit = parseLimit(params.limit);
+      const dueAfter = parseDueBound('due_after', params.due_after);
+      const dueBefore = parseDueBound('due_before', params.due_before);
+
+      const availableLists = await fetchAllowedICloudLists();
+
+      let targetLists = availableLists;
+      if (params.list_ids && params.list_ids.length > 0) {
+        const missing = params.list_ids.filter(
+          (reqId) => !availableLists.some((avail) => avail.listID === reqId)
+        );
+        if (missing.length > 0) {
+          throw new AppError(
+            'NOT_FOUND',
+            `指定的提醒列表不存在或不对应任何已显式绑定的 iCloud 提醒列表: ${missing.join(', ')}`,
+            { hint: '调用 reminders_lists 查询当前可用的提醒列表' }
+          );
+        }
+        targetLists = availableLists.filter((avail) => params.list_ids!.includes(avail.listID));
+      }
+
+      const allReminders: Reminder[] = [];
+      const partialFailures: PartialFailure[] = [];
+
+      for (const targetList of targetLists) {
+        let items: ReminderItem[];
+        try {
+          items = await transport.fetchReminders(targetList.listID);
+        } catch (err: any) {
+          if (targetLists.length === 1) {
+            throw err;
+          }
+          partialFailures.push({
+            list_id: targetList.listID,
+            name: targetList.title,
+            reason: err instanceof AppError ? err.message : String(err),
+          });
+          continue;
+        }
+
+        if (!Array.isArray(items)) {
+          throw new AppError('UPSTREAM_ERROR', 'Bridge 返回的提醒条目不是 JSON 数组');
+        }
+
+        for (const rawItem of items) {
+          if (!rawItem || typeof rawItem !== 'object' || Array.isArray(rawItem)) {
+            throw new AppError('UPSTREAM_ERROR', 'Bridge 返回条目数据结构非法: 期望为 Object');
+          }
+
+          const item = rawItem as unknown as Record<string, unknown>;
+
+          if ('error' in item || 'errorMessage' in item) {
+            throw new AppError('UPSTREAM_ERROR', `Bridge 返回错误对象响应而非正常条目: ${JSON.stringify(item)}`);
+          }
+
+          if (typeof item.itemID !== 'string' || !item.itemID.trim()) {
+            throw new AppError('UPSTREAM_ERROR', `Bridge 返回条目缺失必需的 itemID 字段: ${JSON.stringify(item)}`);
+          }
+
+          if (typeof item.listID !== 'string' || !item.listID.trim()) {
+            throw new AppError('UPSTREAM_ERROR', `Bridge 返回条目缺失必需的 listID 字段: itemID=${item.itemID}`);
+          }
+
+          if (item.listID.trim() !== targetList.listID) {
+            throw new AppError(
+              'UPSTREAM_ERROR',
+              `Bridge 返回条目归属列表 (${item.listID}) 与请求的目标列表 (${targetList.listID}) 不匹配/不一致`
+            );
+          }
+
+          if (typeof item.title !== 'string') {
+            throw new AppError('UPSTREAM_ERROR', `Bridge 返回条目缺失必需的 title 字段: itemID=${item.itemID}`);
+          }
+
+          if (typeof item.isCompleted !== 'boolean') {
+            throw new AppError('UPSTREAM_ERROR', `Bridge 返回条目缺失必需的 isCompleted 布尔字段: itemID=${item.itemID}`);
+          }
+
+          if (params.completed !== undefined && item.isCompleted !== params.completed) {
+            continue;
+          }
+
+          const dueIso = parseBridgeDate(item.dueDate);
+          let dueDateObj: Date | undefined;
+          if (dueIso) {
+            dueDateObj = new Date(dueIso);
+          }
+
+          if (dueAfter !== undefined) {
+            if (!dueDateObj || dueDateObj.getTime() < dueAfter.getTime()) {
+              continue;
+            }
+          }
+          if (dueBefore !== undefined) {
+            if (!dueDateObj || dueDateObj.getTime() > dueBefore.getTime()) {
+              continue;
+            }
+          }
+
+          const reminderObj: Reminder = {
+            reminder_id: String(item.itemID),
+            list_id: targetList.listID,
+            title: String(item.title),
+            completed: Boolean(item.isCompleted),
+            priority: typeof item.priority === 'number' ? item.priority : 0,
+          };
+
+          if (typeof item.notes === 'string') {
+            reminderObj.notes = item.notes;
+          }
+          if (dueIso) {
+            reminderObj.due = dueIso;
+          }
+          if (item.completionDate) {
+            try {
+              const compIso = parseBridgeDate(item.completionDate);
+              if (compIso) reminderObj.completed_at = compIso;
+            } catch {}
+          }
+          if (item.creationDate) {
+            try {
+              const crIso = parseBridgeDate(item.creationDate);
+              if (crIso) reminderObj.created = crIso;
+            } catch {}
+          }
+
+          allReminders.push(reminderObj);
+        }
+      }
+
+      allReminders.sort((a, b) => {
+        if (a.due && b.due) {
+          return new Date(a.due).getTime() - new Date(b.due).getTime();
+        }
+        if (a.due && !b.due) return -1;
+        if (!a.due && b.due) return 1;
+        return a.title.localeCompare(b.title);
+      });
+
+      const truncated = allReminders.length > limit;
+      const returnedReminders = truncated ? allReminders.slice(0, limit) : allReminders;
+
+      const result: ListRemindersResult = {
+        reminders: returnedReminders,
+      };
+
+      if (truncated) {
+        result.truncated = true;
+      }
+
+      if (partialFailures.length > 0) {
+        result.partial_failures = partialFailures;
+      }
+
+      return result;
+    },
+
+    async create(_input: ReminderInput, _listId?: string): Promise<Reminder> {
+      rejectWriteOp('create');
+    },
+
+    async update(_reminderId: string, _patch: Partial<ReminderInput>, _options?: UpdateOptions): Promise<Reminder> {
+      rejectWriteOp('update');
+    },
+
+    async remove(_reminderId: string, _options?: UpdateOptions): Promise<{ deleted: true }> {
+      rejectWriteOp('remove');
+    },
+  };
+}
diff --git a/src/modules/reminders/gateway/transport.ts b/src/modules/reminders/gateway/transport.ts
new file mode 100644
index 0000000..f8deb45
--- /dev/null
+++ b/src/modules/reminders/gateway/transport.ts
@@ -0,0 +1,254 @@
+/**
+ * transport.ts
+ * EventKitReadonlyTransport communicating with MacServer EventKit Bridge over HTTP.
+ * 
+ * Invariants & Hardening:
+ * 1. Strictly READ-ONLY: Never sends POST, PUT, PATCH, DELETE requests.
+ * 2. Unified Deadline: A single abort timer spans connection establishment, header parsing,
+ *    and streaming response body downloading until completion.
+ * 3. Connection & Socket Release: On timeout or abort, active body reader is cancelled and
+ *    released immediately to prevent socket exhaustion.
+ * 4. Max Response Size Enforcement: Byte stream is metered; exceeding limit aborts immediately.
+ * 5. Explicit Failures: Stalled streams, network errors, timeouts, 401, 403, 404, 5xx throw AppError;
+ *    never masquerading as empty arrays.
+ */
+
+import { AppError } from '../../../core/errors.js';
+import type { MacServerGatewayConfig, RemindersList, ReminderItem } from './types.js';
+
+export const COCOA_OFFSET_SECONDS = 978307200;
+
+export function parseBridgeDate(raw: unknown): string | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  if (typeof raw === 'number') {
+    if (!Number.isFinite(raw)) {
+      throw new AppError('UPSTREAM_ERROR', `Bridge 返回非法数值日期: ${raw}`);
+    }
+    const epochMs = (raw + COCOA_OFFSET_SECONDS) * 1000;
+    const d = new Date(epochMs);
+    if (Number.isNaN(d.getTime())) {
+      throw new AppError('UPSTREAM_ERROR', `Bridge 转换 Cocoa 纪元日期失败: ${raw}`);
+    }
+    return d.toISOString();
+  }
+  if (typeof raw === 'string') {
+    const trimmed = raw.trim();
+    if (!trimmed) {
+      throw new AppError('UPSTREAM_ERROR', 'Bridge 返回空日期字符串');
+    }
+    const d = new Date(trimmed);
+    if (Number.isNaN(d.getTime())) {
+      throw new AppError('UPSTREAM_ERROR', `Bridge 返回非法日期格式字符串: ${raw}`);
+    }
+    return d.toISOString();
+  }
+  throw new AppError('UPSTREAM_ERROR', `Bridge 返回非法日期编码类型: ${typeof raw}`);
+}
+
+export class EventKitReadonlyTransport {
+  private readonly config: MacServerGatewayConfig;
+
+  constructor(config: MacServerGatewayConfig) {
+    this.config = config;
+  }
+
+  async healthCheck(): Promise<boolean> {
+    const url = `${this.config.macserverEndpoint}/health`;
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), this.config.timeoutMs);
+    try {
+      const res = await fetch(url, { method: 'GET', signal: controller.signal });
+      return res.status === 200;
+    } catch {
+      return false;
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+
+  async fetchListsMetadata(): Promise<RemindersList[]> {
+    const url = `${this.config.macserverEndpoint}/reminders/lists`;
+    const headers = {
+      Authorization: `Bearer ${this.config.authToken}`,
+      Accept: 'application/json',
+      'User-Agent': 'Seoul-MCP-Gateway/1.0.0 (Readonly)',
+    };
+
+    const data = await this.getBoundedJson<unknown>(url, headers);
+    if (!Array.isArray(data)) {
+      throw new AppError('UPSTREAM_ERROR', 'MacServer EventKit Bridge 返回的列表数据结构非法: 期望为 Array');
+    }
+    return data as RemindersList[];
+  }
+
+  async fetchReminders(listId: string): Promise<ReminderItem[]> {
+    const trimmedId = listId.trim();
+    if (!trimmedId) {
+      throw new AppError('INVALID_INPUT', 'listId 不能为空');
+    }
+
+    const isAllowed = this.config.allowedLists.some((item) => item.listId === trimmedId);
+    if (!isAllowed) {
+      throw new AppError('PERMISSION_DENIED', `列表未在网关白名单中: ${trimmedId} (必须显式配置绑定)`, {
+        hint: '请在 MACSERVER_EVENTKIT_ALLOWED_LISTS 中配置该列表及来源 ID 绑定',
+      });
+    }
+
+    const url = `${this.config.macserverEndpoint}/reminders/lists/${encodeURIComponent(trimmedId)}/items`;
+    const headers = {
+      Authorization: `Bearer ${this.config.authToken}`,
+      Accept: 'application/json',
+      'User-Agent': 'Seoul-MCP-Gateway/1.0.0 (Readonly)',
+    };
+
+    const data = await this.getBoundedJson<unknown>(url, headers);
+    if (!Array.isArray(data)) {
+      throw new AppError('UPSTREAM_ERROR', 'MacServer EventKit Bridge 返回的提醒条目数据结构非法: 期望为 Array');
+    }
+    return data as ReminderItem[];
+  }
+
+  rejectWrite(operation: 'create' | 'update' | 'delete'): never {
+    throw new AppError(
+      'PERMISSION_DENIED',
+      `MacServer EventKit 网关为只读服务: 提醒事项 ${operation} 写操作已在客户端拦截 (零转发/零VTODO回落)`
+    );
+  }
+
+  /**
+   * Unified GET execution spanning request, headers, and full body stream download
+   * under a single deadline timer. Ensures prompt socket release on timeout/abort.
+   */
+  private async getBoundedJson<T>(url: string, headers: Record<string, string>): Promise<T> {
+    const controller = new AbortController();
+    let isTimedOut = false;
+    const timer = setTimeout(() => {
+      isTimedOut = true;
+      controller.abort();
+    }, this.config.timeoutMs);
+
+    let activeReader: ReadableStreamDefaultReader<Uint8Array> | undefined;
+    const onAbort = () => {
+      if (activeReader) {
+        try { activeReader.cancel(); } catch {}
+      }
+    };
+    controller.signal.addEventListener('abort', onAbort, { once: true });
+
+    try {
+      let res: Response;
+      try {
+        res = await fetch(url, {
+          method: 'GET',
+          headers,
+          signal: controller.signal,
+        });
+      } catch (cause: any) {
+        if (isTimedOut || controller.signal.aborted || cause?.name === 'AbortError') {
+          throw new AppError('UPSTREAM_ERROR', `MacServer EventKit Bridge 请求/读取超时 (${this.config.timeoutMs}ms): ${url}`, {
+            cause,
+            retryable: true,
+          });
+        }
+        throw new AppError('UPSTREAM_ERROR', `无法连接到 MacServer EventKit Bridge: ${cause?.message || cause}`, {
+          cause,
+          retryable: true,
+        });
+      }
+
+      if (res.status === 401) {
+        throw new AppError('AUTH_FAILED', 'MacServer EventKit Bridge 鉴权失败: 提供的 Bearer Token 无效或已过期');
+      }
+      if (res.status === 403) {
+        throw new AppError('PERMISSION_DENIED', 'MacServer EventKit 权限拒绝: Bridge 生产授权开关关闭或无权限访问');
+      }
+      if (res.status === 404) {
+        throw new AppError('NOT_FOUND', `MacServer 提醒列表未找到: ${url}`);
+      }
+      if (!res.ok) {
+        throw new AppError('UPSTREAM_ERROR', `MacServer EventKit Bridge 响应异常 (HTTP ${res.status})`);
+      }
+
+      const contentLength = res.headers.get('content-length');
+      if (contentLength && parseInt(contentLength, 10) > this.config.maxResponseSizeBytes) {
+        throw new AppError(
+          'UPSTREAM_ERROR',
+          `MacServer EventKit Bridge 响应体大小 (${contentLength} bytes) 超出限制 (${this.config.maxResponseSizeBytes} bytes)`
+        );
+      }
+
+      let text = '';
+      if (!res.body) {
+        text = await res.text();
+      } else {
+        const reader = res.body.getReader();
+        activeReader = reader;
+        const chunks: Uint8Array[] = [];
+        let receivedBytes = 0;
+
+        try {
+          while (true) {
+            const { done, value } = await reader.read();
+            if (done) break;
+            if (value) {
+              receivedBytes += value.length;
+              if (receivedBytes > this.config.maxResponseSizeBytes) {
+                controller.abort();
+                throw new AppError(
+                  'UPSTREAM_ERROR',
+                  `MacServer EventKit Bridge 响应体大小 (${receivedBytes} bytes) 超出限制 (${this.config.maxResponseSizeBytes} bytes)`
+                );
+              }
+              chunks.push(value);
+            }
+          }
+        } finally {
+          activeReader = undefined;
+          try { reader.releaseLock(); } catch {}
+        }
+
+        if (isTimedOut || controller.signal.aborted) {
+          throw new AppError('UPSTREAM_ERROR', `MacServer EventKit Bridge 请求/读取超时 (${this.config.timeoutMs}ms): ${url}`, {
+            retryable: true,
+          });
+        }
+
+        const totalBuffer = new Uint8Array(receivedBytes);
+        let offset = 0;
+        for (const chunk of chunks) {
+          totalBuffer.set(chunk, offset);
+          offset += chunk.length;
+        }
+        text = new TextDecoder('utf-8').decode(totalBuffer);
+      }
+
+      if (isTimedOut || controller.signal.aborted) {
+        throw new AppError('UPSTREAM_ERROR', `MacServer EventKit Bridge 请求/读取超时 (${this.config.timeoutMs}ms): ${url}`, {
+          retryable: true,
+        });
+      }
+
+      if (!text.trim()) {
+        throw new AppError('UPSTREAM_ERROR', 'MacServer EventKit Bridge 返回空响应体');
+      }
+
+      try {
+        return JSON.parse(text) as T;
+      } catch (cause) {
+        throw new AppError('UPSTREAM_ERROR', 'MacServer EventKit Bridge 返回的成功响应非有效 JSON', { cause });
+      }
+    } catch (err: any) {
+      if (err instanceof AppError) throw err;
+      if (isTimedOut || controller.signal.aborted || err?.name === 'AbortError' || err?.message?.includes('aborted')) {
+        throw new AppError('UPSTREAM_ERROR', `MacServer EventKit Bridge 请求/读取超时 (${this.config.timeoutMs}ms): ${url}`, {
+          cause: err,
+          retryable: true,
+        });
+      }
+      throw new AppError('UPSTREAM_ERROR', `读取 MacServer EventKit 响应异常: ${err?.message || err}`, { cause: err });
+    } finally {
+      controller.signal.removeEventListener('abort', onAbort);
+      clearTimeout(timer);
+    }
+  }
+}
