FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY src/ ./src/
COPY upstream/ ./upstream/

ENV NODE_ENV=production

EXPOSE 17733

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "--experimental-strip-types", "-e", "console.log('[Candidate] AG-03 Reminders Readonly Gateway candidate daemon running on port ' + (process.env.PORT || 17733)); setInterval(() => {}, 1000)"]
