+      allowedLists: [
+        {
+          listId: 'list-allowed-1',
+          expectedSourceId: 'source-icloud-1',
+          expectedSourceName: 'iCloud',
+          expectedSourceType: 'calDAV',
+        },
+      ],
+      expectedSourceType: 'calDAV',
+    };
+
+    const transport = new EventKitReadonlyTransport(config);
+    const service = createMacServerReminderService({
+      transport,
+      config,
+      account: makeAccount(),
