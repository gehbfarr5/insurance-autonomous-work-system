 });
+
+describe("contacts search phone number and regression tests", () => {
+  const regressionBook = cachedBook([
+    [BOOK + "p1.vcf", card("张三", ["ORG:某某科技;研发部", "EMAIL:zhang@example.com", "TEL:+86 138 0000 0002"])],
+    [BOOK + "p2.vcf", card("李四", ["ORG:另一家公司", "EMAIL:li@other.com", "TEL:13800138888"])],
+    [BOOK + "p3.vcf", card("王五", ["TEL:+86 138 0013 0000"])],
+    [BOOK + "p4.vcf", card("客户2", ["TITLE:高级客户", "NOTE:客户专属备注2", "TEL:+86 139 9999 8888"])],
+    [BOOK + "p5.vcf", card("测试员", ["NOTE:包含文本 qz2 以及 zz-wb-accept2 标识"])],
+  ]);
+
+  it("does NOT match contacts solely because phone number contains 2 when query is qz2", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "qz2" });
+    // 张三 phone has 2, but qz2 is text and should not trigger phone digits fallback
+    expect(found.contacts.map((c) => c.name.full)).not.toContain("张三");
+    // Only 测试员 has qz2 in note
+    expect(found.contacts.map((c) => c.name.full)).toEqual(["测试员"]);
+  });
+
+  it("matches 客户2 by normal text and does not match other contacts whose phone contains 2", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "客户2" });
+    expect(found.contacts.map((c) => c.name.full)).toEqual(["客户2"]);
+  });
+
+  it("does NOT trigger phone digit matching when query is zz-wb-accept2", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "zz-wb-accept2" });
+    expect(found.contacts.map((c) => c.name.full)).toEqual(["测试员"]);
+    expect(found.contacts.map((c) => c.name.full)).not.toContain("张三");
+  });
+
+  it("matches 1380013 against both domestic and international formatted phones", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "1380013" });
+    // Matches 李四 (13800138888) and 王五 (+86 138 0013 0000)
+    expect(found.contacts.map((c) => c.name.full).sort()).toEqual(["李四", "王五"]);
+  });
+
+  it("matches +86 138-0013 against normalized phone numbers", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "+86 138-0013" });
+    expect(found.contacts.map((c) => c.name.full).sort()).toEqual(["李四", "王五"]);
+  });
+
+  it("short digit query 2 does NOT match phone numbers, but preserves name/note text matches", async () => {
+    const svc = createContactService({ account: account(), carddav: makeCardDav(), cache: makeCache([regressionBook]) });
+    const found = await svc.search({ query: "2" });
+    // Should match 客户2 (name full, note) and 测试员 (note has qz2 / zz-wb-accept2), but NOT 张三 (phone has 2)
+    expect(found.contacts.map((c) => c.name.full).sort()).toEqual(["客户2", "测试员"]);
+    expect(found.contacts.map((c) => c.name.full)).not.toContain("张三");
