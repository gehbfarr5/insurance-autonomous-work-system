+++ b/src/modules/contacts/group-tools.ts
@@ -0,0 +1,129 @@
+import { z } from 'zod';
+import { AppError } from '../../core/errors.js';
+import { decodeRef, decodeUrl, encodeUrl } from '../../core/ids.js';
+import { contactSchema } from './tools.js';
+import type { ContactInput } from '../../parsers/vcard.js';
+import type { ContactService } from './service.js';
+import { wrapTool } from '../../server/wrap.js';
+import { accessKeyIdFrom, type Session } from '../../core/session.js';
+import type { ToolDeps, ToolExtra, ToolRegistrar } from '../../server/types.js';
+import type { GroupsService } from './groups.js';
+
+interface GroupToolDeps extends ToolDeps {
+  groupsFor: (session: Session) => GroupsService;
+  contactFor: (session: Session) => ContactService;
+}
+
+const session_id = z.string().describe('apple_login 返回的 session_id');
+const group_id = z.string().describe('contacts_groups_list 返回的 group_id');
+const contact_ids = z.array(z.string()).min(1).max(100).describe('contacts_search 返回的 contact_id 列表，必须属于同一通讯簿');
+const expected_etag = z.string().optional().describe('可选 ETag；服务端始终使用最新 ETag 条件写入');
+
+export function registerGroupTools(server: ToolRegistrar, deps: GroupToolDeps): void {
+  const { sessions, logger, groupsFor, contactFor } = deps;
+  const svc = (id: string, extra?: ToolExtra) => groupsFor(sessions.get(id, accessKeyIdFrom(extra)));
+
+  server.registerTool('contacts_groups_list', {
+    title: '列出联系人分组',
+    description: '列出 iCloud 原生联系人分组与成员数量。只读操作，不能把通讯簿和所有联系人误认为分组。',
+    inputSchema: { session_id, address_book_id: z.string().optional() },
+    annotations: { readOnlyHint: true },
+  }, wrapTool(logger, 'contacts_groups_list', async (a: { session_id: string; address_book_id?: string }, e) =>
+    svc(a.session_id, e).list(a.address_book_id)));
+
+  server.registerTool('contacts_groups_members', {
+    title: '读取分组成员',
+    description: '返回分组成员 contact_id 以及无法解析的成员引用，不修改任何联系人。',
+    inputSchema: { session_id, group_id },
+    annotations: { readOnlyHint: true },
+  }, wrapTool(logger, 'contacts_groups_members', async (a: { session_id: string; group_id: string }, e) =>
+    svc(a.session_id, e).members(a.group_id)));
+
+  server.registerTool('contacts_groups_create', {
+    title: '创建联系人分组',
+    description: '创建一个 iCloud 原生联系人分组。检查同一通讯簿同名分组，拒绝重复。',
+    inputSchema: { session_id, name: z.string().min(1).max(100), address_book_id: z.string().optional() },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }, wrapTool(logger, 'contacts_groups_create', async (a: { session_id: string; name: string; address_book_id?: string }, e) =>
+    svc(a.session_id, e).create(a.name, a.address_book_id)));
+
+  server.registerTool('contacts_groups_rename', {
+    title: '重命名联系人分组',
+    description: '只重命名分组卡片，不改变成员。与其他设备更新冲突时返回 CONFLICT。',
+    inputSchema: { session_id, group_id, name: z.string().min(1).max(100), expected_etag },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }, wrapTool(logger, 'contacts_groups_rename', async (a: { session_id: string; group_id: string; name: string; expected_etag?: string }, e) =>
+    svc(a.session_id, e).rename(a.group_id, a.name, a.expected_etag)));
+
+  server.registerTool('contacts_groups_add_members', {
+    title: '将联系人加入分组',
+    description: '使用 contact_id 添加现有联系人到原生分组；已在组内的联系人不会重复加入。失败不会删除联系人。',
+    inputSchema: { session_id, group_id, contact_ids, expected_etag },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }, wrapTool(logger, 'contacts_groups_add_members', async (a: { session_id: string; group_id: string; contact_ids: string[]; expected_etag?: string }, e) =>
+    svc(a.session_id, e).addMembers(a.group_id, a.contact_ids, a.expected_etag)));
+
+  server.registerTool('contacts_groups_remove_members', {
+    title: '从分组中移出联系人',
+    description: '只移除分组成员引用，绝不删除联系人原始卡片。',
+    inputSchema: { session_id, group_id, contact_ids, expected_etag },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }, wrapTool(logger, 'contacts_groups_remove_members', async (a: { session_id: string; group_id: string; contact_ids: string[]; expected_etag?: string }, e) =>
+    svc(a.session_id, e).removeMembers(a.group_id, a.contact_ids, a.expected_etag)));
+
+  server.registerTool('contacts_create_in_groups', {
+    title: '创建联系人并分配分组',
+    description: '一次调用创建联系人并加入 1–10 个已有分组。若联系人创建成功而分组部分失败，会明确返回 contact_created=true 和失败列表；只能重试分组操作，绝不能重复创建联系人。',
+    inputSchema: {
+      session_id,
+      contact: contactSchema,
+      group_ids: z.array(group_id).min(1).max(10),
+      address_book_id: z.string().optional(),
+    },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }, wrapTool(logger, 'contacts_create_in_groups', async (
+    a: { session_id: string; contact: ContactInput; group_ids: string[]; address_book_id?: string }, e,
+  ) => {
+    const session = sessions.get(a.session_id, accessKeyIdFrom(e));
+    const groups = groupsFor(session);
+    const targetBooks = new Set(a.group_ids.map(g => decodeRef(g).collectionUrl));
+    if (targetBooks.size !== 1) throw new AppError('INVALID_INPUT', '所有分组必须属于同一个通讯簿');
+    const targetBook = [...targetBooks][0]!;
+    if (a.address_book_id !== undefined && decodeUrl(a.address_book_id) !== targetBook) {
+      throw new AppError('INVALID_INPUT', '指定的通讯簿与分组不一致');
+    }
+    const ids = [...new Set(a.group_ids)];
+    // Preflight: reject invalid and inaccessible groups before creating a contact.
+    for (const id of ids) {
+      const found = await groups.members(id);
+      if (found.group.address_book_id !== encodeUrl(targetBook)) {
+        throw new AppError('INVALID_INPUT', '分组所属通讯簿与联系人不一致');
+      }
+    }
+    const created = await contactFor(session).create(a.contact, encodeUrl(targetBook));
+    const assigned: string[] = [];
+    const failed: Array<{ group_id: string; reason: string }> = [];
+    for (const id of ids) {
+      try {
+        await groups.addMembers(id, [created.contact_id]);
+        assigned.push(id);
+      } catch (err) {
+        failed.push({ group_id: id, reason: err instanceof Error ? err.message : '分组更新失败' });
+      }
+    }
+    return {
+      contact_created: true,
+      contact: created,
+      group_assignment: { complete: failed.length === 0, assigned_group_ids: assigned, failed },
+      ...(failed.length ? { retry_hint: '联系人已成功创建。只重试 contacts_groups_add_members，不得再次调用创建联系人。' } : {}),
+    };
+  }));
+
+  server.registerTool('contacts_groups_delete', {
+    title: '删除联系人分组',
+    description: '删除分组卡片，成员联系人不删除。必须提供 confirm=true 才允许执行。',
+    inputSchema: { session_id, group_id, confirm: z.literal(true), expected_etag },
+    annotations: { readOnlyHint: false, destructiveHint: true },
+  }, wrapTool(logger, 'contacts_groups_delete', async (a: { session_id: string; group_id: string; confirm: true; expected_etag?: string }, e) =>
+    svc(a.session_id, e).remove(a.group_id, a.confirm, a.expected_etag)));
+}
diff --git a/src/modules/contacts/groups.ts b/src/modules/contacts/groups.ts
new file mode 100644
index 0000000..fd4f9a9
--- /dev/null
+++ b/src/modules/contacts/groups.ts
@@ -0,0 +1,178 @@
+import { AppError } from '../../core/errors.js';
+import { decodeRef, decodeUrl, encodeRef, encodeUrl } from '../../core/ids.js';
+import { capabilityHint, type AccountConfig } from '../../core/config.js';
+import { isGroupVCard, readContactMeta } from '../../parsers/vcard.js';
+import {
+  buildGroupVCard, normalizeMemberUrn, parseGroupVCard, renameGroupVCard, updateGroupMembersVCard,
+} from '../../parsers/vcard-groups.js';
+import type { CardDavProvider, CardObject } from '../../providers/icloud/carddav.js';
+
+export interface GroupView {
+  group_id: string;
+  address_book_id: string;
+  name: string;
+  member_count: number;
+}
+
+export interface GroupsService {
+  list(addressBookId?: string): Promise<{ groups: GroupView[]; partial_failures?: Array<{ address_book_id: string; reason: string }> }>;
+  members(groupId: string): Promise<{ group: GroupView; contacts: Array<{ contact_id: string; uid: string }>; unresolved_member_urns: string[] }>;
+  create(name: string, addressBookId?: string): Promise<GroupView>;
+  rename(groupId: string, name: string, expectedEtag?: string): Promise<GroupView>;
+  addMembers(groupId: string, contactIds: string[], expectedEtag?: string): Promise<{ group: GroupView; added: number }>;
+  removeMembers(groupId: string, contactIds: string[], expectedEtag?: string): Promise<{ group: GroupView; removed: number }>;
+  remove(groupId: string, confirmed: boolean, expectedEtag?: string): Promise<{ deleted: true; contacts_deleted: 0 }>;
+}
+
+export function createGroupsService(deps: { account: AccountConfig; carddav: CardDavProvider }): GroupsService {
+  const { account, carddav } = deps;
+  function checkRead() {
+    if (!account.capabilities.contactsRead) throw new AppError('PERMISSION_DENIED', '通讯录读取权限未开启', { hint: capabilityHint(account, 'ALLOW_CONTACTS_READ') });
+  }
+  function checkWrite() {
+    if (!account.capabilities.contactsWrite) throw new AppError('PERMISSION_DENIED', '通讯录写入权限未开启', { hint: capabilityHint(account, 'ALLOW_CONTACTS_WRITE') });
+  }
+  function view(bookUrl: string, cardUrl: string, data: string): GroupView {
+    const group = parseGroupVCard(data);
+    return { group_id: encodeRef({ collectionUrl: bookUrl, resourceUrl: cardUrl }), address_book_id: encodeUrl(bookUrl), name: group.name, member_count: group.member_urns.length };
+  }
+  function assertResourceWithinBook(bookUrl: string, resourceUrl: string) {
+    let base: URL, card: URL;
+    try {
+      base = new URL(bookUrl);
+      card = new URL(resourceUrl);
+    } catch {
+      throw new AppError('INVALID_INPUT', '分组或联系人 ID 中的资源地址无效');
+    }
+    if (base.protocol !== 'https:' || card.protocol !== 'https:' || base.origin !== card.origin
+      || !card.pathname.startsWith(base.pathname)) {
+      throw new AppError('INVALID_INPUT', '资源地址不属于指定通讯簿');
+    }
+  }
+  async function loaded(groupId: string, expectedEtag?: string) {
+    const ref = decodeRef(groupId);
+    assertResourceWithinBook(ref.collectionUrl, ref.resourceUrl);
+    const books = await carddav.listAddressBooks();
+    if (!books.some(b => b.url === ref.collectionUrl)) {
+      throw new AppError('INVALID_INPUT', '分组 ID 不属于当前账号的通讯簿');
+    }
+    const card = await carddav.fetchOne(ref.collectionUrl, ref.resourceUrl);
+    if (!isGroupVCard(card.data)) throw new AppError('INVALID_INPUT', '目标资源不是联系人分组');
+    if (expectedEtag !== undefined && card.etag !== expectedEtag) throw new AppError('CONFLICT', '分组已被其他设备修改，请重新读取');
+    return { ref, card };
+  }
+  async function writableBook(addressBookId?: string) {
+    const books = await carddav.listAddressBooks();
+    const book = addressBookId === undefined
+      ? books.find(b => !b.readOnly)
+      : books.find(b => b.url === decodeUrl(addressBookId));
+    if (!book) throw new AppError('NOT_FOUND', '未找到可写入的通讯簿');
+    if (book.readOnly) throw new AppError('PERMISSION_DENIED', '通讯簿不允许写入');
+    return book.url;
+  }
+  async function assertNameAvailable(bookUrl: string, name: string, exceptUrl?: string) {
+    const { objects } = await carddav.fetchAll(bookUrl);
+    const duplicate = objects.some(c => c.url !== exceptUrl && isGroupVCard(c.data)
+      && parseGroupVCard(c.data).name.localeCompare(name.trim(), undefined, { sensitivity: 'accent' }) === 0);
+    if (duplicate) throw new AppError('CONFLICT', '该通讯簿已有同名分组，请直接使用已有分组');
+  }
+  async function memberUids(bookUrl: string, ids: string[]): Promise<string[]> {
+    if (!ids.length || ids.length > 100) throw new AppError('INVALID_INPUT', '每次需提供 1–100 个联系人 ID');
+    const uids: string[] = [];
+    for (const id of ids) {
+      const ref = decodeRef(id);
+      if (ref.collectionUrl !== bookUrl) throw new AppError('INVALID_INPUT', '不能将其他通讯簿的联系人加入本分组');
+      assertResourceWithinBook(bookUrl, ref.resourceUrl);
+      const card = await carddav.fetchOne(bookUrl, ref.resourceUrl);
+      if (isGroupVCard(card.data)) throw new AppError('INVALID_INPUT', '分组不能作为另一个分组的成员');
+      const uid = readContactMeta(card.data).uid;
+      if (!uid) throw new AppError('INVALID_INPUT', '联系人缺少 UID，不能修改分组成员');
+      uids.push(normalizeMemberUrn(uid));
+    }
+    return [...new Set(uids.map(v => v.toLowerCase()))];
+  }
+
+  return {
+    async list(addressBookId) {
+      checkRead();
+      const books = (await carddav.listAddressBooks()).filter(b => addressBookId === undefined || b.url === decodeUrl(addressBookId));
+      if (addressBookId !== undefined && books.length === 0) throw new AppError('NOT_FOUND', '通讯簿不存在');
+      const groups: GroupView[] = [], partial_failures: Array<{ address_book_id: string; reason: string }> = [];
+      for (const book of books) {
+        try {
+          const { objects } = await carddav.fetchAll(book.url);
+          for (const card of objects) if (isGroupVCard(card.data)) groups.push(view(book.url, card.url, card.data));
+        } catch (e) {
+          partial_failures.push({ address_book_id: encodeUrl(book.url), reason: e instanceof Error ? e.message : '通讯簿读取失败' });
+        }
+      }
+      groups.sort((a, b) => a.name.localeCompare(b.name));
+      return partial_failures.length ? { groups, partial_failures } : { groups };
+    },
+
+    async members(groupId) {
+      checkRead();
+      const { ref, card } = await loaded(groupId);
+      const group = parseGroupVCard(card.data);
+      const { objects } = await carddav.fetchAll(ref.collectionUrl);
+      const mapped = new Map<string, CardObject>();
+      for (const item of objects) {
+        if (isGroupVCard(item.data)) continue;
+        const uid = readContactMeta(item.data).uid;
+        if (uid) mapped.set(normalizeMemberUrn(uid).toLowerCase(), item);
+      }
+      const contacts: Array<{ contact_id: string; uid: string }> = [];
+      const unresolved_member_urns: string[] = [];
+      for (const urn of group.member_urns) {
+        const item = mapped.get(urn.toLowerCase());
+        if (item) contacts.push({ contact_id: encodeRef({ collectionUrl: ref.collectionUrl, resourceUrl: item.url }), uid: readContactMeta(item.data).uid! });
+        else unresolved_member_urns.push(urn);
+      }
+      return { group: view(ref.collectionUrl, ref.resourceUrl, card.data), contacts, unresolved_member_urns };
+    },
+
+    async create(name, addressBookId) {
+      checkWrite();
+      const book = await writableBook(addressBookId);
+      const { data, uid } = buildGroupVCard(name);
+      await assertNameAvailable(book, name);
+      const created = await carddav.create({ bookUrl: book, filename: uid + '.vcf', data });
+      return view(book, created.url, data);
+    },
+
+    async rename(groupId, name, expectedEtag) {
+      checkWrite();
+      const { ref, card } = await loaded(groupId, expectedEtag);
+      const changed = renameGroupVCard(card.data, name);
+      await assertNameAvailable(ref.collectionUrl, name, ref.resourceUrl);
+      await carddav.update({ bookUrl: ref.collectionUrl, url: ref.resourceUrl, etag: card.etag, data: changed });
+      return view(ref.collectionUrl, ref.resourceUrl, changed);
+    },
+
+    async addMembers(groupId, contactIds, expectedEtag) {
+      checkWrite();
+      const { ref, card } = await loaded(groupId, expectedEtag);
+      const uids = await memberUids(ref.collectionUrl, contactIds);
+      const changed = updateGroupMembersVCard(card.data, uids);
+      if (changed.changed) await carddav.update({ bookUrl: ref.collectionUrl, url: ref.resourceUrl, etag: card.etag, data: changed.data });
+      return { group: view(ref.collectionUrl, ref.resourceUrl, changed.data), added: changed.changed };
+    },
+
+    async removeMembers(groupId, contactIds, expectedEtag) {
+      checkWrite();
+      const { ref, card } = await loaded(groupId, expectedEtag);
+      const uids = await memberUids(ref.collectionUrl, contactIds);
+      const changed = updateGroupMembersVCard(card.data, [], uids);
+      if (changed.changed) await carddav.update({ bookUrl: ref.collectionUrl, url: ref.resourceUrl, etag: card.etag, data: changed.data });
+      return { group: view(ref.collectionUrl, ref.resourceUrl, changed.data), removed: changed.changed };
+    },
+
+    async remove(groupId, confirmed, expectedEtag) {
+      checkWrite();
+      if (!confirmed) throw new AppError('INVALID_INPUT', '删除分组需要明确确认，不会删除成员联系人');
+      const { ref, card } = await loaded(groupId, expectedEtag);
+      await carddav.remove({ bookUrl: ref.collectionUrl, url: ref.resourceUrl, etag: card.etag });
+      return { deleted: true, contacts_deleted: 0 };
+    },
+  };
+}
