diff --git a/tests/unit/modules/contact-group-tools.test.ts b/tests/unit/modules/contact-group-tools.test.ts
new file mode 100644
index 0000000..aa11713
--- /dev/null
+++ b/tests/unit/modules/contact-group-tools.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it, vi } from 'vitest';
+import { registerGroupTools } from '../../../src/modules/contacts/group-tools.js';
+import { encodeRef, encodeUrl } from '../../../src/core/ids.js';
+import { createLogger } from '../../../src/core/logger.js';
+import type { SessionStore } from '../../../src/core/session.js';
+import type { ToolConfig, ToolResult } from '../../../src/server/types.js';
+
+const BOOK = 'https://contacts.example.com/b/';
+const G = encodeRef({ collectionUrl: BOOK, resourceUrl: BOOK + 'g.vcf' });
+const session = { id: 's1' };
+const logger = createLogger('error', () => {});
+function setup(failAssignment = false) {
+  const handlers = new Map<string, { config: ToolConfig; handler: (a: any, e?: any) => Promise<ToolResult> }>();
+  const server = { registerTool(name: string, config: ToolConfig, handler: (a: any, e?: any) => Promise<ToolResult>) {
+    handlers.set(name, { config, handler });
+  } };
+  const sessions = { get: vi.fn().mockReturnValue(session) } as unknown as SessionStore;
+  const create = vi.fn().mockResolvedValue({ contact_id: 'c1', name: { full: '客户A' } });
+  const addMembers = vi.fn().mockImplementation(async () => { if (failAssignment) throw Error('iCloud conflict'); return { added: 1 }; });
+  const groupsFor = () => ({
+    list: vi.fn(), members: vi.fn().mockResolvedValue({ group: { group_id: G, address_book_id: encodeUrl(BOOK) } }),
+    create: vi.fn(), rename: vi.fn(), addMembers, removeMembers: vi.fn(), remove: vi.fn(),
+  });
+  registerGroupTools(server as never, { sessions, logger, groupsFor, contactFor: () => ({ create }) } as never);
+  return { handlers, sessions, create, addMembers };
+}
+
+describe('group MCP tools', () => {
+  it('exposes 8 group tools with safe annotations', () => {
+    const { handlers } = setup();
+    expect([...handlers.keys()].sort()).toEqual([
+      'contacts_create_in_groups', 'contacts_groups_add_members', 'contacts_groups_create',
+      'contacts_groups_delete', 'contacts_groups_list', 'contacts_groups_members',
+      'contacts_groups_remove_members', 'contacts_groups_rename',
+    ]);
+    expect(handlers.get('contacts_groups_list')!.config.annotations?.readOnlyHint).toBe(true);
+    expect(handlers.get('contacts_groups_delete')!.config.annotations?.destructiveHint).toBe(true);
+  });
+  it('creates contact exactly once before assigning group membership', async () => {
+    const { handlers, create, addMembers } = setup();
+    const res = await handlers.get('contacts_create_in_groups')!.handler({
+      session_id: 's1', contact: { name: { full: '客户A' } }, group_ids: [G],
+    });
+    const body = JSON.parse(res.content[0]!.text);
+    expect(res.isError).not.toBe(true);
+    expect(body.contact_created).toBe(true);
+    expect(body.group_assignment.complete).toBe(true);
+    expect(create).toHaveBeenCalledOnce();
+    expect(create).toHaveBeenCalledWith({ name: { full: '客户A' } }, encodeUrl(BOOK));
+    expect(addMembers).toHaveBeenCalledWith(G, ['c1']);
+  });
+  it('returns partial success and contact ID if group assignment fails', async () => {
+    const { handlers, create } = setup(true);
+    const res = await handlers.get('contacts_create_in_groups')!.handler({
+      session_id: 's1', contact: { name: { full: '客户A' } }, group_ids: [G],
+    });
+    const body = JSON.parse(res.content[0]!.text);
+    expect(body.contact_created).toBe(true);
+    expect(body.contact.contact_id).toBe('c1');
+    expect(body.group_assignment.complete).toBe(false);
+    expect(body.group_assignment.failed).toHaveLength(1);
+    expect(body.retry_hint).toMatch(/不得再次调用创建联系人/);
+    expect(create).toHaveBeenCalledOnce();
+  });
+  it('refuses conflicting address books before contact is created', async () => {
+    const { handlers, create } = setup();
+    const res = await handlers.get('contacts_create_in_groups')!.handler({
+      session_id: 's1', contact: { name: { full: '客户A' } }, group_ids: [G],
+      address_book_id: encodeUrl('https://contacts.example.com/other/'),
+    });
+    expect(res.isError).toBe(true);
+    expect(JSON.parse(res.content[0]!.text).error.code).toBe('INVALID_INPUT');
+    expect(create).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/unit/modules/contacts-groups.test.ts b/tests/unit/modules/contacts-groups.test.ts
new file mode 100644
index 0000000..199e1da
--- /dev/null
+++ b/tests/unit/modules/contacts-groups.test.ts
@@ -0,0 +1,152 @@
+import { describe, expect, it, vi } from 'vitest';
+import { AppError } from '../../../src/core/errors.js';
+import { encodeRef, encodeUrl } from '../../../src/core/ids.js';
+import { buildGroupVCard, parseGroupVCard, renameGroupVCard, updateGroupMembersVCard } from '../../../src/parsers/vcard-groups.js';
+import { createGroupsService } from '../../../src/modules/contacts/groups.js';
+import type { AccountConfig } from '../../../src/core/config.js';
+import type { CardDavProvider } from '../../../src/providers/icloud/carddav.js';
+
+const BOOK = 'https://contacts.icloud.com/addressbook/';
+const GROUP_URL = BOOK + 'group.vcf';
+const CONTACT_URL = BOOK + 'person.vcf';
+const groupId = encodeRef({ collectionUrl: BOOK, resourceUrl: GROUP_URL });
+const contactId = encodeRef({ collectionUrl: BOOK, resourceUrl: CONTACT_URL });
+const contact = ['BEGIN:VCARD', 'VERSION:3.0', 'UID:PERSON-1', 'FN:客户A', 'N:客户A;;;;', 'END:VCARD'].join('\r\n');
+const existing = [
+  'BEGIN:VCARD', 'VERSION:3.0', 'UID:GROUP-1', 'FN:客户群', 'N:客户群;;;;',
+  'X-ADDRESSBOOKSERVER-KIND:group',
+  'X-ADDRESSBOOKSERVER-MEMBER:urn:uuid:PERSON-2',
+  'X-APPLE-SPECIAL:preserve-me', 'END:VCARD',
+].join('\r\n');
+
+function account(read = true, write = true): AccountConfig {
+  return {
+    id: 'account_1', email: 'test@icloud.com', sender: 'test@icloud.com', label: 'test', appPassword: 'test',
+    capabilities: {
+      mailRead: false, mailWrite: false, calendarRead: false, calendarWrite: false,
+      remindersRead: false, remindersWrite: false, contactsRead: read, contactsWrite: write,
+    },
+  };
+}
+function mockDav() {
+  return {
+    listAddressBooks: vi.fn().mockResolvedValue([{ url: BOOK, name: 'Contacts', readOnly: false }]),
+    fetchAll: vi.fn().mockResolvedValue({ objects: [
+      { url: GROUP_URL, data: existing, etag: '"g1"' },
+      { url: CONTACT_URL, data: contact, etag: '"p1"' },
+    ] }),
+    fetchOne: vi.fn().mockImplementation(async (_book: string, url: string) =>
+      url === GROUP_URL
+        ? { url, data: existing, etag: '"g1"' }
+        : { url, data: contact, etag: '"p1"' }),
+    create: vi.fn().mockResolvedValue({ url: BOOK + 'created.vcf' }),
+    update: vi.fn().mockResolvedValue(undefined),
+    remove: vi.fn().mockResolvedValue(undefined),
+  };
+}
+
+describe('native iCloud group card parser', () => {
+  it('builds an iCloud group and parses its UID and name', () => {
+    const { uid, data } = buildGroupVCard(' 客户组 ');
+    expect(data).toMatch(/X-ADDRESSBOOKSERVER-KIND:group/i);
+    expect(parseGroupVCard(data)).toEqual({ uid, name: '客户组', member_urns: [] });
+  });
+  it('preserves unknown Apple metadata when renaming', () => {
+    const renamed = renameGroupVCard(existing, '新客户组');
+    expect(parseGroupVCard(renamed).name).toBe('新客户组');
+    expect(renamed).toContain('X-APPLE-SPECIAL:preserve-me');
+    expect(parseGroupVCard(renamed).member_urns).toEqual(['urn:uuid:PERSON-2']);
+  });
+  it('adds once, does not duplicate and can remove without touching other members', () => {
+    const once = updateGroupMembersVCard(existing, ['PERSON-1']);
+    expect(once.changed).toBe(1);
+    expect(parseGroupVCard(once.data).member_urns).toHaveLength(2);
+    expect(updateGroupMembersVCard(once.data, ['person-1']).changed).toBe(0);
+    const removed = updateGroupMembersVCard(once.data, [], ['PERSON-1']);
+    expect(removed.changed).toBe(1);
+    expect(parseGroupVCard(removed.data).member_urns).toEqual(['urn:uuid:PERSON-2']);
+    expect(removed.data).toContain('X-APPLE-SPECIAL:preserve-me');
+  });
+  it('refuses to mutate an ordinary contact card', () => {
+    expect(() => updateGroupMembersVCard(contact, ['PERSON-1'])).toThrow(AppError);
+  });
+});
+
+describe('group service guardrails', () => {
+  it('lists groups and ignores ordinary contact cards', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const out = await svc.list();
+    expect(out.groups).toEqual([{ group_id: groupId, address_book_id: encodeUrl(BOOK), name: '客户群', member_count: 1 }]);
+  });
+  it('resolves members and reports missing references', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const out = await svc.members(groupId);
+    expect(out.contacts).toEqual([]);
+    expect(out.unresolved_member_urns).toEqual(['urn:uuid:PERSON-2']);
+  });
+  it('adds existing contacts by UID, and updates only group card with ETag', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const out = await svc.addMembers(groupId, [contactId, contactId]);
+    expect(out.added).toBe(1);
+    expect(dav.update).toHaveBeenCalledTimes(1);
+    expect(dav.update.mock.calls[0]![0]).toMatchObject({ bookUrl: BOOK, url: GROUP_URL, etag: '"g1"' });
+    expect(dav.remove).not.toHaveBeenCalled();
+  });
+  it('does not write the card for already-existing members', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const result = await svc.addMembers(groupId, [contactId]); // first add
+    expect(result.added).toBe(1);
+    dav.fetchOne.mockImplementation(async (_book: string, url: string) =>
+      url === GROUP_URL
+        ? { url, etag: '"g2"', data: updateGroupMembersVCard(existing, ['PERSON-1']).data }
+        : { url, etag: '"p1"', data: contact });
+    dav.update.mockClear();
+    expect((await svc.addMembers(groupId, [contactId])).added).toBe(0);
+    expect(dav.update).not.toHaveBeenCalled();
+  });
+  it('refuses a stale expected etag before writing', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    await expect(svc.addMembers(groupId, [contactId], '"old"')).rejects.toMatchObject({ code: 'CONFLICT' });
+    expect(dav.update).not.toHaveBeenCalled();
+  });
+  it('never deletes contact when removing group, requires explicit confirmation', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    await expect(svc.remove(groupId, false)).rejects.toMatchObject({ code: 'INVALID_INPUT' });
+    expect(dav.remove).not.toHaveBeenCalled();
+    expect(await svc.remove(groupId, true)).toEqual({ deleted: true, contacts_deleted: 0 });
+    expect(dav.remove).toHaveBeenCalledWith({ bookUrl: BOOK, url: GROUP_URL, etag: '"g1"' });
+  });
+  it('rejects a forged group URL outside account books before network fetch', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const forgedId = encodeRef({ collectionUrl: 'https://other.example/b/', resourceUrl: 'https://other.example/b/g.vcf' });
+    await expect(svc.members(forgedId)).rejects.toMatchObject({ code: 'INVALID_INPUT' });
+    expect(dav.fetchOne).not.toHaveBeenCalled();
+  });
+  it('rejects contact URL that is outside the group address book', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    const forgedId = encodeRef({ collectionUrl: BOOK, resourceUrl: 'https://elsewhere.example/ssrf' });
+    await expect(svc.addMembers(groupId, [forgedId])).rejects.toMatchObject({ code: 'INVALID_INPUT' });
+    expect(dav.update).not.toHaveBeenCalled();
+    expect(dav.fetchOne).toHaveBeenCalledTimes(1);
+  });
+  it('denies writes without account permission', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(true, false), carddav: dav as unknown as CardDavProvider });
+    await expect(svc.create('test')).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });
+    expect(dav.create).not.toHaveBeenCalled();
+  });
+  it('denies duplicate group creation', async () => {
+    const dav = mockDav();
+    const svc = createGroupsService({ account: account(), carddav: dav as unknown as CardDavProvider });
+    await expect(svc.create('客户群')).rejects.toMatchObject({ code: 'CONFLICT' });
+    expect(dav.create).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/unit/modules/contacts-search-phone.test.ts b/tests/unit/modules/contacts-search-phone.test.ts
new file mode 100644
index 0000000..34c75a8
--- /dev/null
+++ b/tests/unit/modules/contacts-search-phone.test.ts
@@ -0,0 +1,115 @@
+import { describe, it, expect } from "vitest";
+import { isPhoneQuery, digitsOnly, matchesQuery } from "../../../src/modules/contacts/service.js";
+import type { Contact } from "../../../src/parsers/vcard.js";
+
+function makeContact(overrides: Partial<Contact> = {}): Contact {
+  return {
+    contact_id: "id_1",
+    address_book_id: "book_1",
+    name: { full: "测试名", family: "测试", given: "名" },
+    emails: [],
+    phones: [],
+    urls: [],
+    addresses: [],
+    impp: [],
+    has_photo: false,
+    ...overrides,
+  };
+}
+
+describe("isPhoneQuery format validation", () => {
+  it("recognizes valid phone query strings", () => {
+    expect(isPhoneQuery("13800138888")).toBe(true);
+    expect(isPhoneQuery("+86 138-0013")).toBe(true);
+    expect(isPhoneQuery("(010) 8888 9999")).toBe(true);
+    expect(isPhoneQuery("+1 (555) 234-5678")).toBe(true);
+    expect(isPhoneQuery("138.0000.0000")).toBe(true);
+    expect(isPhoneQuery("010/12345678")).toBe(true);
+    expect(isPhoneQuery("010–12345678")).toBe(true); // en-dash
+    expect(isPhoneQuery("010—12345678")).toBe(true); // em-dash
+    expect(isPhoneQuery("（010）88888888")).toBe(true); // full-width parentheses
+    expect(isPhoneQuery(" 13800000000 ")).toBe(true); // with whitespace
+  });
+
+  it("rejects non-phone text queries", () => {
+    expect(isPhoneQuery("qz2")).toBe(false);
+    expect(isPhoneQuery("客户2")).toBe(false);
+    expect(isPhoneQuery("zz-wb-accept2")).toBe(false);
+    expect(isPhoneQuery("zhang@example.com")).toBe(false);
+    expect(isPhoneQuery("张三")).toBe(false);
+    expect(isPhoneQuery("")).toBe(false);
+    expect(isPhoneQuery("   ")).toBe(false);
+    expect(isPhoneQuery("user_123")).toBe(false);
+    expect(isPhoneQuery("dept#2")).toBe(false);
+  });
+});
+
+describe("digitsOnly extraction", () => {
+  it("strips all non-digit characters", () => {
+    expect(digitsOnly("+86 138-0000 0000")).toBe("8613800000000");
+    expect(digitsOnly("(010) 8888-9999")).toBe("01088889999");
+    expect(digitsOnly("qz2")).toBe("2");
+    expect(digitsOnly("")).toBe("");
+  });
+});
+
+describe("matchesQuery phone search boundaries", () => {
+  const contactWithPhone = makeContact({
+    name: { full: "张三", family: "张", given: "三" },
+    phones: [{ value: "+86 138 0000 0002" }],
+  });
+
+  const contactWithDomestic = makeContact({
+    name: { full: "李四", family: "李", given: "四" },
+    phones: [{ value: "13800138888" }],
+  });
+
+  it("does not match phone containing 2 when query is qz2", () => {
+    expect(matchesQuery(contactWithPhone, "qz2")).toBe(false);
+  });
+
+  it("does not match phone containing 2 when query is 客户2", () => {
+    expect(matchesQuery(contactWithPhone, "客户2")).toBe(false);
+  });
+
+  it("does not match phone containing 2 when query is zz-wb-accept2", () => {
+    expect(matchesQuery(contactWithPhone, "zz-wb-accept2")).toBe(false);
+  });
+
+  it("does not match phone containing 2 when query is 2 (below 4 digits)", () => {
+    expect(matchesQuery(contactWithPhone, "2")).toBe(false);
+  });
+
+  it("does not match phone when query has 3 digits (123)", () => {
+    const contact = makeContact({ phones: [{ value: "+86 138 1234 5678" }] });
+    expect(matchesQuery(contact, "123")).toBe(false);
+  });
+
+  it("matches phone when query reaches 4 digits (1234)", () => {
+    const contact = makeContact({ phones: [{ value: "+86 138 1234 5678" }] });
+    expect(matchesQuery(contact, "1234")).toBe(true);
+  });
+
+  it("matches +86 138-0013 against domestic number 13800138888", () => {
+    expect(matchesQuery(contactWithDomestic, "+86 138-0013")).toBe(true);
+  });
+
+  it("matches 1380013 against domestic number 13800138888", () => {
+    expect(matchesQuery(contactWithDomestic, "1380013")).toBe(true);
+  });
+
+  it("matches 1380000 against international number +86 138 0000 0002", () => {
+    expect(matchesQuery(contactWithPhone, "1380000")).toBe(true);
+  });
+
+  it("matches name text even if name contains digits", () => {
+    const c = makeContact({ name: { full: "客户2" }, phones: [{ value: "+86 139 0000 0000" }] });
+    expect(matchesQuery(c, "客户2")).toBe(true);
+    expect(matchesQuery(c, "2")).toBe(true);
+  });
+
+  it("matches note text even if note contains qz2", () => {
+    const c = makeContact({ note: "备注 qz2 测试" });
+    expect(matchesQuery(c, "qz2")).toBe(true);
+  });
+});
