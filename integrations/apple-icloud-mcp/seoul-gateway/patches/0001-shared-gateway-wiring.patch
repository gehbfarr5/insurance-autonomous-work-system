+    expect((await svc.search({ query: "张三" })).contacts.map((c) => c.name.full)).toEqual(["张三"]);
+    expect((await svc.search({ query: "zhang@example.com" })).contacts.map((c) => c.name.full)).toEqual(["张三"]);
+    expect((await svc.search({ query: "研发部" })).contacts.map((c) => c.name.full)).toEqual(["张三"]);
+    expect((await svc.search({ query: "另一家公司" })).contacts.map((c) => c.name.full)).toEqual(["李四"]);
+    expect((await svc.search({ query: "高级客户" })).contacts.map((c) => c.name.full)).toEqual(["客户2"]);
