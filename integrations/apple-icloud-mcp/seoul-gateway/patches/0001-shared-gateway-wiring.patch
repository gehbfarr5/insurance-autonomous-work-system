+/** 合法的电话查询格式字符：数字、+、空格、括号、连字符、斜杠、点等 */
+const PHONE_QUERY_CHARS_RE = /^[+\d\s()./–—（）-]+$/;
+
+/**
+ * 判断查询字符串是否符合电话号码输入形式。
+ * 只有全由电话合法符号组成且非空的查询，才被允许触发数字归一化电话匹配。
+ * 包含字母或汉字的混合文本（如 qz2、客户2、zz-wb-accept2）不作为电话号码解析。
+ */
+export function isPhoneQuery(query: string): boolean {
+  const trimmed = query.trim();
+  if (!trimmed) return false;
+  return PHONE_QUERY_CHARS_RE.test(trimmed);
+}
