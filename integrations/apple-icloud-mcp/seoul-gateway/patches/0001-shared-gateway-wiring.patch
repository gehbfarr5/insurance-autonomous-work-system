diff --git a/src/parsers/vcard-groups.ts b/src/parsers/vcard-groups.ts
new file mode 100644
index 0000000..a1d8b7f
--- /dev/null
+++ b/src/parsers/vcard-groups.ts
@@ -0,0 +1,117 @@
+import { randomUUID } from 'node:crypto';
+import ICAL from 'ical.js';
+import { AppError } from '../core/errors.js';
+import { isGroupVCard } from './vcard.js';
+
+export interface GroupVCard {
+  uid: string;
+  name: string;
+  member_urns: string[];
+}
+
+function rootOf(text: string): ICAL.Component {
+  try {
+    const root = new ICAL.Component(ICAL.parse(text) as unknown[]);
+    if (root.name !== 'vcard') throw new Error('not vCard');
+    return root;
+  } catch (cause) {
+    throw new AppError('UPSTREAM_ERROR', '通讯录分组 vCard 解析失败', { cause });
+  }
+}
+
+function groupOf(text: string): ICAL.Component {
+  const root = rootOf(text);
+  if (!isGroupVCard(text)) throw new AppError('INVALID_INPUT', '目标资源不是联系人分组');
+  return root;
+}
+
+function scalar(root: ICAL.Component, name: string): string {
+  const raw = root.getFirstPropertyValue(name);
+  return typeof raw === 'string' ? raw.trim() : '';
+}
+
+function memberProperty(root: ICAL.Component): string {
+  return scalar(root, 'version') === '4.0' ? 'member' : 'x-addressbookserver-member';
+}
+
+export function normalizeMemberUrn(uid: string): string {
+  const bare = uid.trim().replace(/^urn:uuid:/i, '');
+  if (!bare || /[\s\r\n]/.test(bare)) throw new AppError('INVALID_INPUT', '联系人 UID 无效，不能加入分组');
+  return 'urn:uuid:' + bare;
+}
+
+export function parseGroupVCard(text: string): GroupVCard {
+  const root = groupOf(text);
+  const uid = scalar(root, 'uid');
+  const name = scalar(root, 'fn');
+  if (!uid || !name) throw new AppError('UPSTREAM_ERROR', '分组卡片缺少 UID 或名称');
+  const urns = [
+    ...root.getAllProperties('x-addressbookserver-member'),
+    ...root.getAllProperties('member'),
+  ].map(p => String(p.getFirstValue() ?? '').trim()).filter(Boolean);
+  return { uid, name, member_urns: urns };
+}
+
+export function buildGroupVCard(name: string): { uid: string; data: string } {
+  const trimmed = name.trim();
+  if (!trimmed || trimmed.length > 100 || /[\r\n]/.test(trimmed)) {
+    throw new AppError('INVALID_INPUT', '分组名必须为 1–100 个字符，且不能包含换行');
+  }
+  const uid = randomUUID();
+  const root = new ICAL.Component('vcard');
+  // iCal.js uses the first property to detect the vCard 3.0 design set.
+  root.addPropertyWithValue('version', '3.0');
+  root.addPropertyWithValue('uid', uid);
+  root.addPropertyWithValue('fn', trimmed);
+  root.addPropertyWithValue('n', [trimmed, '', '', '', '']);
+  root.addPropertyWithValue('x-addressbookserver-kind', 'group');
+  root.addPropertyWithValue('rev', new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z'));
+  return { uid, data: root.toString() };
+}
+
+function stamp(root: ICAL.Component): void {
+  root.removeAllProperties('rev');
+  root.addPropertyWithValue('rev', new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z'));
+}
+
+export function renameGroupVCard(text: string, name: string): string {
+  const trimmed = name.trim();
+  if (!trimmed || trimmed.length > 100 || /[\r\n]/.test(trimmed)) {
+    throw new AppError('INVALID_INPUT', '分组名必须为 1–100 个字符，且不能包含换行');
+  }
+  const root = groupOf(text);
+  root.removeAllProperties('fn');
+  root.addPropertyWithValue('fn', trimmed);
+  root.removeAllProperties('n');
+  root.addPropertyWithValue('n', [trimmed, '', '', '', '']);
+  stamp(root);
+  return root.toString();
+}
+
+export function updateGroupMembersVCard(text: string, additions: string[] = [], removals: string[] = []): { data: string; changed: number } {
+  const root = groupOf(text);
+  const key = (v: string) => v.toLowerCase();
+  const before = parseGroupVCard(text).member_urns;
+  const remove = new Set(removals.map(v => key(normalizeMemberUrn(v))));
+  const kept = before.filter(v => !remove.has(key(v)));
+  const seen = new Set(kept.map(key));
+  const next = [...kept];
+  for (const v of additions) {
+    const urn = normalizeMemberUrn(v);
+    if (!seen.has(key(urn))) { next.push(urn); seen.add(key(urn)); }
+  }
+  const previous = new Set(before.map(key));
+  const following = new Set(next.map(key));
+  const changed = [...previous].filter(v => !following.has(v)).length
+    + [...following].filter(v => !previous.has(v)).length;
+  if (changed === 0) return { data: text, changed: 0 };
+  root.removeAllProperties('x-addressbookserver-member');
+  root.removeAllProperties('member');
+  for (const urn of next) root.addPropertyWithValue(memberProperty(root), urn);
+  stamp(root);
+  const data = root.toString();
+  if (Buffer.byteLength(data, 'utf8') > 240 * 1024) {
+    throw new AppError('INVALID_INPUT', '分组卡片接近 iCloud 容量上限，请拆分客户分组');
+  }
+  return { data, changed };
+}
